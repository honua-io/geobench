# GeoBench environment configuration
# Copy to .env and adjust as needed.

# Legacy broad-runner defaults. Feature campaigns require digest references.
# See docs/feature-campaigns.md; export the pinned image variables for that runner.
POSTGIS_IMAGE=postgis/postgis:17-3.5
HONUA_IMAGE=ghcr.io/honua-io/honua-server:nightly-aot
GEOSERVER_IMAGE=docker.osgeo.org/geoserver:3.0.1
QGIS_IMAGE=qgis/qgis-server:3.38
K6_IMAGE=grafana/k6:0.54.0

# Host port mappings
POSTGIS_PORT=25432
HONUA_PORT=8081
GEOSERVER_PORT=8082
QGIS_PORT=8083

# Credentials
HONUA_ADMIN_PASSWORD=geobench-admin-key
GEOSERVER_ADMIN_PASSWORD=geoserver

# Benchmark settings (used by run-benchmark.sh)
RUNS=5
SERVERS="honua geoserver qgis"
