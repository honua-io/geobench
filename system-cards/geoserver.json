{
  "name": "GeoServer",
  "version": "2.28.x",
  "image": "docker.osgeo.org/geoserver:2.28.x",
  "imageDigest": "docker.osgeo.org/geoserver@sha256:48fcd9488f35c29ef8b8dd2d0b6ae491d1bef73cea83f0ef27f6fa124ddcf245",
  "runtime": "Java (JVM, Jetty)",
  "language": "Java",
  "ogcApiFeatures": {
    "basePath": "/geoserver/ogc/features/v1",
    "conformance": ["Part 1: Core", "Part 2: CRS", "Part 3: Filtering (CQL2)"],
    "cql2Support": true,
    "cql2Dialects": ["cql2-text"],
    "outputFormats": ["geojson", "gml", "shapefile"]
  },
  "resources": {
    "cpus": 4,
    "memory": "4g"
  },
  "configTier": "bounded-baseline",
  "jvmFlags": "GeoServer image defaults",
  "extensions": {
    "stable": ["ogcapi-features"],
    "community": ["gsr"]
  },
  "connectionPooling": {
    "minConnections": 3,
    "maxConnections": 6,
    "looseBbox": false,
    "preparedStatements": false,
    "encodeFunctions": true
  },
  "spatialIndex": "GiST (PostGIS)",
  "geoWebCache": "disabled for benchmark layers",
  "notes": "Headline April 2026 runs use the 2.28.x nightly image with the GSR community extension enabled. GeoWebCache is explicitly disabled for non-WMTS bench_points rows. GeoServer serves the typed bench_points source table with the dataset btree/GiST indexes. Exact image tag and any run-time pool overrides are recorded in benchmark-metadata.json."
}
