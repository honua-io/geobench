{
  "name": "GeoServer",
  "version": "3.0.1",
  "image": "docker.osgeo.org/geoserver:3.0.1",
  "runtime": "Java (JVM, Tomcat)",
  "language": "Java",
  "ogcApiFeatures": {
    "basePath": "/geoserver/ogc/features/v1",
    "conformance": [
      "Part 1: Core",
      "Part 2: CRS",
      "Part 3: Filtering (CQL2)"
    ],
    "cql2Support": true,
    "cql2Dialects": [
      "cql2-text"
    ],
    "outputFormats": [
      "geojson",
      "gml",
      "shapefile"
    ]
  },
  "resources": {
    "cpus": 4,
    "memory": "4g"
  },
  "configTier": "bounded-baseline",
  "jvmFlags": "GeoServer image defaults",
  "extensions": {
    "stable": [
      "ogcapi-features"
    ],
    "community": []
  },
  "connectionPooling": {
    "minConnections": 3,
    "maxConnections": 6,
    "looseBbox": false,
    "preparedStatements": false,
    "encodeFunctions": true
  },
  "spatialIndex": "GiST (PostGIS)",
  "geoWebCache": "disabled for benchmark layers",
  "notes": "GeoServer 3.0.1 stable with OGC API Features extension. GSR is a separate optional community-extension profile. GeoWebCache is disabled for non-WMTS bench_points rows. Typed source table uses dataset btree/GiST indexes. Actual resolved images and resource limits are captured in server-runtime.json; run overrides are in benchmark-metadata.json."
}
