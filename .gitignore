# Raw outputs, including loose files, stay local. Existing tracked files remain tracked.
/results/*
!/results/.gitkeep
# Existing tracked releases, baselines and fixtures remain tracked at their paths.
# New output in legacy folders also requires explicit curated publication.

# Approved curated packages are tracked; incomplete promotion state is local.
/published/.*.staging-*/
/published/.*.publishing

# Python
__pycache__/
*.pyc
.venv/

# Docker
pgdata/

# Generated data (regenerate with: python3 data/small/generate.py)
data/small/init.sql

# Environment overrides
.env

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*~
